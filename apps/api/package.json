{
  "name": "@newsales/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "test": "tsx --env-file-if-exists=../../.env --test test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.8",
    "@fastify/rate-limit": "^11.2.2",
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.2",
    "baileys": "7.0.0-rc14",
    "bullmq": "^6.7.6",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.4.0",
    "prisma": "6.19.3",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "dotenv-cli": "^11.1.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "yazl": "^3.3.1"
  }
}
