# Configuração da instalação com Docker Compose.
# Gere este arquivo com:  ./scripts/setup-env.sh   (preenche os segredos sozinho)
# Nunca versione o .env. Guarde uma cópia em local seguro, separada dos backups do banco.

# --- Endereço público ---
# Com domínio (DNS apontando para este servidor), o HTTPS é automático:
#   SITE_ADDRESS=whats.suaempresa.com.br
#   PUBLIC_URL=https://whats.suaempresa.com.br
# Para testar sem domínio, só HTTP na porta 80:
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost

# --- Banco (use só letras e números na senha) ---
POSTGRES_USER=newsales
POSTGRES_DB=newsales
POSTGRES_PASSWORD=

# --- Segredos (gere cada um com: openssl rand -hex 32) ---
JWT_SECRET=
# Cifra as credenciais das sessões WhatsApp e os segredos de 2FA.
# Se perder esta chave, todos os números precisam ler o QR Code de novo. FAÇA BACKUP.
ENCRYPTION_KEY=

# --- Primeiro administrador ---
# Criado na primeira subida. Depois do primeiro login, pode apagar a senha daqui.
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=

# --- Gerais ---
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info
MAX_NUMBERS=10
MAX_UPLOAD_MB=50

# --- Espelhamento ---
# true = pede ao celular o histórico completo no pareamento; false = só o recente.
SYNC_FULL_HISTORY=true
# Mídias do histórico só são baixadas se a mensagem tiver até N dias (0 = nenhuma).
HISTORY_MEDIA_DAYS=7
MAX_MEDIA_MB=100

# --- Conexão com o WhatsApp (normalmente vazio) ---
# Força a versão do WhatsApp Web (ex.: 2.3000.1029000000); vazio = busca a atual sozinho.
WA_VERSION=
# Como o sistema se identifica: chrome (padrão, WhatsApp Web) ou desktop (app de computador;
# pede histórico completo, mas o WhatsApp pode recusar o pareamento).
WA_BROWSER=chrome
# Detalhe dos logs da biblioteca do WhatsApp: warn (padrão) ou debug (diagnóstico).
BAILEYS_LOG_LEVEL=warn
# Versão da Graph API da Meta (pesquisa de perfis do Instagram). Troque só se a Meta desativar esta.
META_GRAPH_VERSION=v24.0
# IA do SDR: chave da API da Anthropic (console.anthropic.com → API Keys). Cobrada por uso.
ANTHROPIC_API_KEY=

# --- Mídia: "local" (volume Docker) ou "s3" (Amazon S3, MinIO ou compatível) ---
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# --- Desenvolvimento local, sem Docker (npm run dev:*) ---
# DATABASE_URL=postgresql://newsales:SENHA@localhost:5432/newsales?schema=public
# REDIS_URL=redis://localhost:6379
# STORAGE_LOCAL_PATH=./data/media
