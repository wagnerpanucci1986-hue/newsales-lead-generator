# Copie para .env e preencha. Nunca versione o .env.

# --- Geral ---
NODE_ENV=production
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=info
WEB_URL=http://localhost:3000        # origem liberada no CORS / Socket.IO
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Banco e fila ---
POSTGRES_USER=newsales
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=newsales
# Com Docker Compose os hosts são "postgres" e "redis"; rodando direto na máquina, use localhost.
DATABASE_URL=postgresql://newsales:troque-esta-senha@postgres:5432/newsales?schema=public
REDIS_URL=redis://redis:6379

# --- Segredos (gere cada um com: openssl rand -hex 32) ---
JWT_SECRET=
# Cifra as credenciais das sessões WhatsApp e os segredos 2FA.
# Se perder esta chave, todos os números precisam reler o QR Code. Faça backup.
ENCRYPTION_KEY=
# true quando o painel é servido por HTTPS (obrigatório em produção).
COOKIE_SECURE=false

# --- Primeiro administrador (usado só pelo seed) ---
ADMIN_EMAIL=admin@exemplo.com.br
ADMIN_PASSWORD=

# --- Limites ---
MAX_NUMBERS=10
MAX_UPLOAD_MB=50

# --- Espelhamento ---
# true = pede ao celular o histórico completo no pareamento; false = só o recente.
SYNC_FULL_HISTORY=true
# Mídias do histórico só são baixadas se a mensagem tiver até N dias (0 = não baixar mídia de histórico).
HISTORY_MEDIA_DAYS=7
# Mídias acima deste tamanho não são baixadas.
MAX_MEDIA_MB=100

# --- Mídia: "local" (volume Docker) ou "s3" (S3/MinIO) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/media
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
